{
  "name": "@roku-manager/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Core utilities for managing Roku devices",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "vite-node src/index.ts",
    "build": "vite build",
    "start": "node dist/index.js",
    "lint": "oxlint src public test",
    "format": "oxfmt src public test --write",
    "format:check": "oxfmt src public test --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
