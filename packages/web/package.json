{
  "name": "roku-manager-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small web UI and API for managing Roku usage limits.",
  "scripts": {
    "dev": "vite build --watch",
    "dev:hmr": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "format": "oxfmt src index.html --write",
    "format:check": "oxfmt src index.html --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@roku-manager/core": "workspace:*",
    "@tanstack/preact-query": "^5.105.2",
    "@tanstack/preact-store": "^0.13.5",
    "chart.js": "^4.6.1",
    "lucide-preact": "^1.66.0",
    "preact": "^11.1.1",
    "wouter-preact": "^3.13.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.4",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "^4.3.4",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
