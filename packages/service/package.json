{
  "name": "@roku-manager/service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small web UI and API for managing Roku usage limits.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "pnpm --filter roku-manager-web build && vite build",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.js",
    "lint": "oxlint src public test",
    "format": "oxfmt src public test --write",
    "format:check": "oxfmt src public test --check",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "hono": "4.13.16",
    "hono-pino": "0.10.3",
    "hono-problem-details": "^0.12.0",
    "lru-cache": "^11.5.3",
    "pino": "10.4.0",
    "roku-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@roku-manager/core": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-node": "catalog:"
  }
}
