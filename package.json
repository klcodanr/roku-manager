{
  "name": "roku-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small web UI and API for managing Roku usage limits.",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "ssdp": "node src/ssdp-cli.js",
    "test": "node --test",
    "lint": "oxlint src public test",
    "format": "oxfmt src public test --write",
    "format:check": "oxfmt src public test --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "hono-pino": "0.10.3",
    "pino": "10.4.0",
    "roku-client": "6.0.0",
    "rotating-file-stream": "3.2.10"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.6.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "semantic-release": "25.0.9",
    "supertest": "7.3.1",
    "typescript": "7.0.2"
  }
}
