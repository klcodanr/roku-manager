{
  "name": "roku-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "description": "A small web UI and API for managing Roku usage limits.",
  "scripts": {
    "build": "pnpm --filter @roku-manager/service build",
    "start": "pnpm --filter @roku-manager/service start",
    "dev": "pnpm --filter roku-manager-web build && pnpm --parallel --filter roku-manager-web --filter @roku-manager/service dev",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "format": "pnpm -r --if-present format",
    "format:check": "pnpm -r --if-present format:check",
    "typecheck": "pnpm -r --if-present typecheck",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1"
  },
  "workspaces": [
    "packages/core",
    "packages/service",
    "packages/web"
  ]
}
